# Keep SQLite as the default until a PostgreSQL database passes migration checks.
DATABASE_URL=sqlite:///./mkulima.db
# PostgreSQL example; configure a separate staging database before switching.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/mkulima
AUTH_SECRET=replace_with_a_long_random_secret
ADMIN_BOOTSTRAP_TOKEN=replace_with_a_long_random_token

DARAJA_KEY=replace_with_daraja_consumer_key
DARAJA_SECRET=replace_with_daraja_consumer_secret
SHORTCODE=174379
PASSKEY=replace_with_daraja_passkey
DARAJA_CALLBACK_SECRET=replace_with_a_long_random_secret
CALLBACK_URL=https://your-public-url/api/payments/mpesa/callback

# Configure Africa's Talking for farmer verification and listing-enquiry SMS.
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=your_sandbox_api_key_here
# Optional; use only an approved Africa's Talking sender ID.
AFRICASTALKING_SENDER_ID=
